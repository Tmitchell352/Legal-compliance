# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — Developers → API keys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Developers → Product catalog → create "Pro" and "Portfolio" recurring prices, paste their price IDs
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_PORTFOLIO=

# Resend — resend.com/api-keys
RESEND_API_KEY=
EMAIL_FROM="Permitly <reminders@yourdomain.com>"

# Random string you generate — also set as CRON_SECRET in Vercel project settings
CRON_SECRET=

# Your deployed site URL (used in email links + OAuth-style redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
